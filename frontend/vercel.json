{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mern-backend-qgfh.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
